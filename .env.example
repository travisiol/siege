# ─── Site ────────────────────────────────────────────────────────────────────
# Everything here is optional. With no contract address the site stays in
# demonstration: the board is the balance simulation's output, the order panel
# is disabled, and `isLive` is false. No invented address can ship by accident.

NEXT_PUBLIC_SITE_URL=https://hexwar.world
NEXT_PUBLIC_HEXWAR_NETWORK=Base Sepolia

# The buy flow turns on when all four of these are set. Until then the order
# panel says plainly that there is nothing to trade yet — there is no third
# state and nothing to remember to flip by hand.
NEXT_PUBLIC_HEXWAR_LIVE=false
NEXT_PUBLIC_HEXWAR_BATTLE_ADDRESS=
NEXT_PUBLIC_HEXWAR_MAP_ADDRESS=
NEXT_PUBLIC_HEXWAR_TOKEN_ADDRESS=

# ISO timestamp of tick 1. Drives the countdown.
NEXT_PUBLIC_HEXWAR_SEASON_START=2026-08-24T00:00:00Z

NEXT_PUBLIC_HEXWAR_X=
NEXT_PUBLIC_HEXWAR_DISCORD=

# Where the board comes from. Unset means the site draws the simulation's
# exported season and labels it as such. Point this at a running indexer to
# serve the live board instead — the shape is identical either way.
NEXT_PUBLIC_HEXWAR_INDEXER_URL=

# 84532 = Base Sepolia (default), 8453 = Base.
NEXT_PUBLIC_HEXWAR_CHAIN_ID=84532
NEXT_PUBLIC_HEXWAR_RPC_URL=

# ─── Deployment ──────────────────────────────────────────────────────────────
# Read by contracts/script/Deploy.s.sol.

HEXWAR_TREASURY=0x0000000000000000000000000000000000000000
# Unix seconds for tick 1.
HEXWAR_SEASON_START=1800000000
# Empire curve: 200 = hexCount^2 (the brief), 150 = ^1.5, 100 = linear.
# The simulation burns ~63% of staked capital per season at 200 on a fixed
# supply. Pick this deliberately.
HEXWAR_EMPIRE_EXPONENT=200
# Flat bond locked per commitment, in wei. Public by design — a per-order bond
# that varied with the stake would leak the stake.
HEXWAR_COMMIT_BOND=10000000000000000000
# Yield a tier-1 hex accrues per tick, in wei. Tier 2 pays 3x, tier 3 pays 8x.
HEXWAR_YIELD_UNIT=5000000000000000000

# ─── Keeper ──────────────────────────────────────────────────────────────────
# Resolves each tick once its reveal window shuts. Permissionless: anyone can
# run one, and more than one is fine.

HEXWAR_RPC_URL=
HEXWAR_BATTLE_ADDRESS=
HEXWAR_KEEPER_KEY=
HEXWAR_BATCH=64

# ─── Indexer ─────────────────────────────────────────────────────────────────
# Mirrors the chain into SQLite and serves /board and /replay/:tick. Wipe the
# database and it rebuilds identically from the deploy block — nothing is stored
# that cannot be replayed from logs.

HEXWAR_MAP_ADDRESS=
HEXWAR_DEPLOY_BLOCK=0
HEXWAR_DB=indexer/hexwar.db
HEXWAR_INDEXER_PORT=8787
HEXWAR_CHAIN_ID=84532
# Whole tokens, used to fill the board's economics fields.
HEXWAR_SEASON_POOL=2000000
HEXWAR_YIELD_UNIT_TOKENS=5
